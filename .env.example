# Vercel environment: use the Neon POOLED URL. Never expose it to the browser.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/relay?sslmode=require&channel_binding=require
# Run migrations with Neon's DIRECT URL, not the pooled URL.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/relay?sslmode=require&channel_binding=require
RELAY_SECURE_COOKIES=true
# Local HTTP development only: RELAY_SECURE_COOKIES=false

# Optional public customer-support address. Omit until you have a real support mailbox.
RELAY_SUPPORT_EMAIL=

# Browser-visible Mapbox PUBLIC token only (pk.*). Restrict allowed URLs in Mapbox.
RELAY_MAPBOX_PUBLIC_TOKEN=
# Optional Mapbox style URL; no Google key or Map ID is used.
RELAY_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
# Private Cloudflare R2 (S3-compatible) bucket. Never use these credentials in browser code.
RELAY_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
RELAY_S3_BUCKET=
RELAY_S3_REGION=auto
RELAY_S3_ACCESS_KEY_ID=
RELAY_S3_SECRET_ACCESS_KEY=

# Public Smartsupp WEBSITE installation key, not a REST API token.
# Optional: configured chat loads automatically on page startup. Review provider privacy settings first.
RELAY_SMARTSUPP_KEY=
# User-approved dashboard placement; false disables chat on admin pages.
RELAY_SMARTSUPP_ADMIN_ENABLED=true

# Production-first: sample shipments are disabled unless explicitly enabled locally.
RELAY_DEMO_MODE=false
# Public quote requests: Cloudflare Turnstile (site key public, secret server-only).
RELAY_TURNSTILE_SITE_KEY=
RELAY_TURNSTILE_SECRET=
# Comma-separated exact website hostnames, no scheme/port/path.
RELAY_TURNSTILE_HOSTNAMES=
# Optional dedicated random HMAC secret for hashed-IP quote rate buckets.
RELAY_QUOTE_RATE_SECRET=
# LOCAL DEVELOPMENT ONLY; ignored when VERCEL is set. Never enable for public hosting.
RELAY_ALLOW_UNVERIFIED_QUOTES=false

# Self-hosting only: enable ONLY behind a trusted proxy that overwrites X-Forwarded-For.
# Vercel uses its own edge-forwarded client address automatically.
RELAY_TRUST_PROXY=false
